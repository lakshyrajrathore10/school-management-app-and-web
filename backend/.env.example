# Application Configuration
PORT=5001
NODE_ENV=development
APP_NAME="School Staff Attendance API"
API_PREFIX=/api/v1

# Database Configuration (MongoDB)
MONGODB_URI="mongodb://127.0.0.1:27017/sas_db"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production-12345"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-67890"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Security & CORS
CORS_ORIGIN="*"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Default School Geofence Anchor Configuration
SCHOOL_NAME="Whiteleaf International School"
SCHOOL_LATITUDE=22.719568
SCHOOL_LONGITUDE=75.857727
SCHOOL_RADIUS_METERS=200
SCHOOL_TIMEZONE="Asia/Kolkata"
SHIFT_START_TIME="09:00"
SHIFT_END_TIME="17:00"
GRACE_MINUTES=15

# Upload & File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
S3_ENDPOINT=""
S3_BUCKET="sas-attendance-selfies"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ap-south-1"
